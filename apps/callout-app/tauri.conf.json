{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CallOut",
  "identifier": "io.github.berabozgoz.callout",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": "cd ../ui && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CallOut",
        "label": "main",
        "width": 420,
        "height": 780,
        "center": true,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwQjBDMTdFMEJFMUNFNDUKUldSRnp1RUxmc0d3OFBLQnpPOTgzd05oV3BqZjIwOGFkOTZ4VW9xb3RWek5xVktKT0x5ZkJ5eTMK",
      "endpoints": [
        "https://github.com/berabozgoz/callout/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Turkish",
          "German",
          "Spanish",
          "French",
          "Arabic",
          "SimpChinese",
          "Japanese",
          "Russian",
          "PortugueseBR",
          "Korean"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "shortDescription": "Low-latency voice chat for gamers",
    "publisher": "berabozgoz"
  }
}
